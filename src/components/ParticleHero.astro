---
interface Props {
  name: string;
  subtitle?: string;
}

const { name, subtitle } = Astro.props;
---

<div class="particle-hero">
  <canvas id="particle-hero-canvas" class="particle-hero-canvas" aria-hidden="true"></canvas>
  <h1 class="particle-hero-fallback">{name}</h1>
  {subtitle && <p class="particle-hero-subtitle">{subtitle}</p>}
</div>

<script>
  import '../scripts/features/particle-hero';
</script>

---
const home = import.meta.env.BASE_URL || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Minh-Ha Nguyen</title>
    <link rel="canonical" href="https://mh-nguyen.cv/" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${home}`} />
    <script is:inline define:vars={{ home }}>window.location.replace(home);</script>
  </head>
  <body><p>Continue to <a href={home}>Minh-Ha Nguyen's homepage</a>.</p></body>
</html>

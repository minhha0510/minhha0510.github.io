---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(post => !post.data.slug.endsWith('-vi'))
  .map((post) => ({
    slug: post.data.slug,
    title: post.data.title,
    date: post.data.date,
    excerpt: post.data.excerpt,
    readingTime: post.data.readingTime,
    category: post.data.category,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
---

<Layout title="Minh-Ha Nguyen">
  <div class="intro">
    <h1 class="intro-title">Minh-Ha Nguyen</h1>
    <p class="intro-text">
      I'm a PhD candidate in Epidemiology at Vanderbilt. I build agentic AI systems and
      evaluate them the way an epidemiologist reads evidence: a score is an estimate, and the
      work is finding the hidden biases that decide whether to believe it.
    </p>
    <p class="intro-text intro-training">
      Training: experimental design, statistical and causal inference for observational data,
      and scientific computing for large-scale health data.
    </p>
    <a class="intro-cv" href={`${base}cv/Minh_Ha_Nguyen_CV.pdf`}>CV (PDF)</a>
    <a class="intro-cv" href={`${base}portfolio/`}>Research portfolio</a>
  </div>

  <section class="research-section">
    <h2 class="section-title">Research</h2>
    <div class="threads">
      <div class="thread">
        <h3>Evaluating models as experiments</h3>
        <p>
          A benchmark is an experiment. The model is a population, the prompt is a treatment you
          assign, and the score is an estimator with sampling error and measurement error. So I
          ask what epidemiology asks of any study: is the sample representative, is the comparison
          powered and fair, is the reference standard reliable, and could selection or leakage
          explain the result?
        </p>
        <a class="thread-tag" href="https://www.nature.com/articles/s41746-026-03109-z" target="_blank" rel="noopener noreferrer">// meta-analysis published in npj Digital Medicine</a>
      </div>
      <div class="thread">
        <h3>PIHF-MCP: agents that learn from expert investigation</h3>
        <p>
          Policy Iteration with Human Feedback turns the way experts investigate model failures
          into a reusable, recorded policy. An agent executes that policy while the model weights
          stay fixed. PIHF-MCP automates the loop; in the preprint, policies developed from a few
          labelled examples improved performance on unseen cases and across models.
        </p>
        <a class="thread-tag" href="https://arxiv.org/abs/2608.16831" target="_blank" rel="noopener noreferrer">// preprint on arXiv</a>
      </div>
      <div class="thread">
        <h3>liteOdyssey: rare-disease diagnosis you can inspect</h3>
        <p>
          liteOdyssey consolidates model failures and expert corrections into a clinician-gated
          natural-language policy for rare-disease diagnosis. The system is evaluated on held-out
          cases across benchmarks and model families and, after adaptation, in the Undiagnosed
          Diseases Network with blinded physician adjudication. Reviewers can run it in a live
          workbench: question the system, inspect its tool trace and reasoning, and test where the
          policy holds or fails.
        </p>
        <a class="thread-tag" href="https://liteodyssey.org" target="_blank" rel="noopener noreferrer">// liteodyssey.org</a>
        <a class="thread-tag" href="https://liteodyssey.org/#trace" target="_blank" rel="noopener noreferrer">// demo video</a>
        <a class="thread-tag" href="https://liteodyssey.org/odysseus" target="_blank" rel="noopener noreferrer">// live workbench (request access)</a>
        <a class="thread-tag" href="https://arxiv.org/abs/2606.16149" target="_blank" rel="noopener noreferrer">// preprint on arXiv</a>
      </div>
      <div class="thread">
        <h3>Below the Surface: hidden bias in large-scale health data</h3>
        <p>
          My dissertation models the biases that sit below an estimate: how outcomes and
          exposures are measured, who gets selected into a cohort, and how far an unmeasured
          confounder could move the answer. The setting is NASA-supported research on low-dose
          radiation and Parkinson's disease in Navy submariners. The same habits run through my
          medication-safety work, from nationwide new-user cohorts to depression risk with
          5-alpha reductase inhibitors.
        </p>
        <a class="thread-tag" href={`${base}about`}>// about the dissertation</a>
      </div>
    </div>
  </section>

  <section class="posts-section">
    <h2 class="section-title">Latest Posts</h2>
    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <article>
            <div class="post-meta">
              <time class="post-date" datetime={post.date}>{formatDate(post.date)}</time>
              {post.category && <span class="post-category">{post.category}</span>}
            </div>
            <h3 class="post-title">
              <a href={`${base}posts/${post.slug}`}>{post.title}</a>
            </h3>
            <p class="post-excerpt">{post.excerpt}</p>
            <span class="reading-time">{post.readingTime} min read</span>
          </article>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .intro {
    text-align: center;
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .intro-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    color: var(--text);
  }

  .intro-text {
    font-size: 1.125rem;
    color: var(--text-muted);
    line-height: 1.7;
    text-align: center;
    margin: 0;
  }

  .intro-training {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: var(--text-light);
  }

  .intro-cv {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.3rem 0.75rem;
  }

  .intro-cv:hover {
    border-color: var(--accent);
  }

  .research-section {
    padding: 1rem 0 0;
    margin-bottom: 1.5rem;
  }

  .threads {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .thread {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    padding: 1.25rem 1.5rem;
  }

  .thread h3 {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
  }

  .thread p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .thread-tag {
    display: inline-block;
    margin-top: 0.6rem;
    margin-right: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-light);
    text-decoration: none;
  }

  a.thread-tag:hover {
    color: var(--accent);
  }

  .posts-section {
    padding: 1rem 0;
  }

  .section-title {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-light);
    margin: 0 0 1.5rem 0;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    padding: 2rem 0;
    border-bottom: 1px solid var(--border-light);
  }

  .post-item:first-child {
    padding-top: 0;
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-light);
  }

  .post-category {
    background: var(--bg-elevated);
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
  }

  .post-title a {
    color: var(--text);
    text-decoration: none;
  }

  .post-title a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .post-excerpt {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 0.75rem 0;
  }

  .reading-time {
    font-size: 0.875rem;
    color: var(--text-light);
  }

  @media (max-width: 640px) {
    .intro {
      padding: 1.5rem 0 2rem;
    }

    .intro-title {
      font-size: 2rem;
    }

    .intro-text {
      font-size: 1rem;
    }

    .post-title {
      font-size: 1.25rem;
    }
  }
</style>

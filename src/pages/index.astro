---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts')).filter(p => !p.data.slug.endsWith('-vi')).sort((a,b) => new Date(b.data.date).getTime()-new Date(a.data.date).getTime());
---
<Layout title="Minh-Ha Nguyen" description="PhD candidate in Epidemiology at Vanderbilt. Agentic AI, rigorous evaluation, and evidence in health research.">
  <header class="intro">
    <p class="section-label">Epidemiology · Agentic AI</p>
    <h1>Minh-Ha Nguyen<span class="name-dot" aria-hidden="true">.</span></h1>
    <p class="intro-lead">I build AI systems and investigate<br class="desktop-break" /> when to trust their answers.</p>
    <p class="intro-context">PhD candidate in Epidemiology at Vanderbilt. My work connects scientific agents, experimental design, and the hidden biases in health data.</p>
    <div class="intro-links"><a class="primary-link" href="/portfolio/">Explore my work <span aria-hidden="true">↗</span></a><a href="/cv/Minh_Ha_Nguyen_CV.pdf">CV (PDF)</a><a href="mailto:ha.m.nguyen@vanderbilt.edu">Email</a><a href="https://github.com/minhha0510">GitHub</a></div>
  </header>
  <section class="home-section" aria-labelledby="work-title">
    <div class="section-heading"><h2 id="work-title">Selected work</h2><a href="/portfolio/">Portfolio <span aria-hidden="true">↗</span></a></div>
    <article class="work-row"><span class="work-number" aria-hidden="true">01</span><div><h3><a href="/portfolio/liteodyssey/">liteOdyssey</a></h3><p>Rare-disease diagnosis with a clinician-gated policy and an inspectable evidence trail.</p><a class="quiet-link" href="https://liteodyssey.org">Project & live workbench ↗</a></div><span class="work-type">Scientific agents</span></article>
    <article class="work-row"><span class="work-number" aria-hidden="true">02</span><div><h3><a href="/portfolio/pihf-mcp/">PIHF-MCP</a></h3><p>Agents that investigate failures and improve written policies while model weights stay fixed.</p><a class="quiet-link" href="https://arxiv.org/abs/2608.16831">Preprint ↗</a></div><span class="work-type">Policy learning</span></article>
    <article class="work-row"><span class="work-number" aria-hidden="true">03</span><div><h3><a href="/research/">What makes a result credible?</a></h3><p>AI evaluation and health-data research, grounded in measurement, selection, and causal inference.</p><a class="quiet-link" href="https://www.nature.com/articles/s41746-026-03109-z">Meta-analysis · npj Digital Medicine ↗</a></div><span class="work-type">Evaluation</span></article>
    <p class="section-tail"><a href="/hairloss/">Hair-loss evidence + access</a><span> · </span><a href="/research/">Research background</a></p>
  </section>
  <section class="home-section writing-section" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">Writing</h2><a href="/writing/">All posts ↗</a></div>
    <ul class="writing-list">{posts.slice(0,2).map(p => <li><a href={`/posts/${p.data.slug}`}>{p.data.title}</a><span>{p.data.readingTime} min read</span></li>)}</ul>
  </section>
</Layout>
<style>
.intro{padding:1.2rem 0 2rem}.intro h1{font-size:clamp(2rem,5vw,3rem);letter-spacing:-.055em;margin:.4rem 0 .8rem;font-weight:650;line-height:1.1}.name-dot{color:var(--accent)}.intro-lead{font-size:clamp(1.3rem,3vw,1.8rem);line-height:1.35;font-weight:500;letter-spacing:-.03em;margin:0 0 .9rem}.intro-context{max-width:60ch;color:var(--text-muted);margin:0 0 1.1rem}.intro-links{display:flex;align-items:center;flex-wrap:wrap;gap:.6rem 1.4rem;font-size:.9rem}.intro-links a{padding:.3rem 0}.primary-link{font-weight:650}.primary-link span{margin-left:.4rem}.home-section{border-top:1px solid var(--border);padding-top:1.25rem;margin-bottom:1.6rem}.section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:.5rem}.section-heading h2{font-size:1rem;margin:0;font-weight:650}.section-heading>a{font-size:.85rem}.work-row{display:grid;grid-template-columns:1.7rem minmax(0,1fr) auto;gap:.7rem;padding:1rem 0;border-bottom:1px solid var(--border-light)}.work-number{font-size:.75rem;color:var(--text-light);padding-top:.25rem;font-variant-numeric:tabular-nums}.work-row h3{font-size:1.05rem;margin:0 0 .3rem}.work-row h3 a{color:var(--text)}.work-row p{color:var(--text-muted);margin:0;font-size:.95rem;line-height:1.55;max-width:55ch}.quiet-link{font-size:.8rem;display:inline-block;margin-top:.4rem}.work-type{color:var(--text-light);font-size:.73rem;white-space:nowrap;padding-top:.25rem}.section-tail{font-size:.85rem;margin:1rem 0 0}.writing-list{list-style:none;padding:0;margin:0}.writing-list li{display:flex;gap:1.5rem;justify-content:space-between;align-items:baseline;padding:.65rem 0}.writing-list a{color:var(--text);font-size:.95rem;max-width:57ch}.writing-list span{white-space:nowrap;font-size:.75rem;color:var(--text-light)}
@media(max-width:600px){.intro{padding:.5rem 0 1.6rem}.desktop-break{display:none}.work-row{grid-template-columns:1.5rem minmax(0,1fr)}.work-type{grid-column:2;padding:0}.writing-list li{display:block}.writing-list span{display:block;margin-top:.25rem}.intro-links{gap:.5rem 1rem}}
</style>

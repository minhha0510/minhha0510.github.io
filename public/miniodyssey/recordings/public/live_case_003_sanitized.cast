[125.952004,"o","\u001b[2;135H   — 7/12 terms, the highest overlap. Let me verify with OMIM.                                                                  \u001b[30m\u001b[43m[0/47]\u001b[39m\u001b[49m\u001b[3;135H                                                \u001b[K\u001b[38;5;114m\u001b[4;135H●\u001b[39m \u001b[1mBash\u001b(B\u001b[m(dx-omim gene --name \"STAT3\")                                \u001b[K\u001b[38;5;246m\u001b[5;135H  ⎿  \u001b[39m{                           \u001b[K\u001b[6;135H       \"gene\": \"STAT3\",          \u001b[K\u001b[7;135H       \"gene_info\": {            \u001b[K\u001b[8;135H     \u001b[2m… +21 lines (ctrl+o to expand)\u001b(B\u001b[m                                \u001b[K\u001b[9;135H\u001b[K\u001b[38;5;114m\n●\u001b[39m \u001b[1mBash\u001b(B\u001b[m(dx-omim gene --name \"IL6ST\")                \u001b[K\u001b[38;5;246m\u001b[11;135H  ⎿  \u001b[39m{                           \u001b[K\u001b[12;135H       \"gene\": \"IL6ST\",          \u001b[K\u001b[13;135H       \"gene_info\": {                               \u001b[K\u001b[14;135H     \u001b[2m… +33 lines (ctrl+o to expand)\u001b(B\u001b[m                                \u001b[K\u001b[15;135H\u001b[K\u001b[38;5;114m\n●\u001b[39m \u001b[1mBash\u001b(B\u001b[m(dx-omim gene --name \"DOCK8\")            \u001b[K\u001b[38;5;246m\u001b[17;135H  ⎿  \u001b[39m{                           \u001b[K\u001b[18;135H \u001b[1X\u001b[C     \"gene\": \"DOCK8\",                                    \u001b[K\u001b[19;135H       \"gene_info\": {                               \u001b[K\u001b[20;135H \u001b[4X\u001b[2m\u001b[4C… +15 lines (ctrl+o to expand)\u001b(B\u001b[m\u001b[K\u001b[21;135H\u001b[K\u001b[38;5;231m\n●\u001b[39m STAT3 uniquely matches the craniofacial anchors AND the full immunologic\u001b[1X\u001b[Cpicture.\u001b[1X\u001b[CIL6ST\u001b[1X\u001b[C(HIES-4)\u001b[1X\u001b[Cis\u001b[1X\u001b[Ca\u001b[1X\u001b[Crare\u001b[1X\u001b[CSTAT3-phenocopy\u001b[1X\u001b[Cbut\u001b[K\u001b[23;135H  missed the coarse-facies signal; DOCK8-HIES typically features severe cutaneous viral disease, which isn't in this case; CGD genes  \u001b[24;135H  match the oxidative-burst term but lack the entire IgE/eczema/facial gestalt. I'm confident this is classic Job syndrome.           \u001b[25;135H                                                \u001b[K\u001b[26;135H  ---                            \u001b[K\u001b[27;135H  \u001b[1mLeading diagnosis\u001b(B\u001b[m                                        \u001b[K\u001b[28;135H\u001b[K\n  \u001b[30m\u001b[43mT\u001b[39m\u001b[49mhis patient has \u001b[1mAutosomal\u001b(B\u001b[m \u001b[1mDominant\u001b(B\u001b[m \u001b[1mHyper-IgE\u001b(B\u001b[m \u001b[1mSyndrome\u001b(B\u001b[m \u001b[1m(Job\u001b(B\u001b[m \u001b[1msyndrome)\u001b(B\u001b[m caused by a dominant-negative variant in \u001b[1mSTAT3\u001b(B\u001b[m (OMIM 147060). \u001b[30;135H  The presentation is textbook, and I rate confidence as \u001b[1mhigh\u001b(B\u001b[m.     \u001b[K\u001b[31;135H\u001b[K\n \u001b[1X\u001b[1m\u001b[CWhy\u001b(B\u001b[m\u001b[1X\u001b[1m\u001b[Cit\u001b(B\u001b[m\u001b[1X\u001b[1m\u001b[Cfits\u001b(B\u001b[m\u001b[K\u001b[33;135H\u001b[K\n \u001b[1X\u001b[C-\u001b[1X\u001b[CThe\u001b[1X\u001b[Cfacial\u001b[1X\u001b[Cgestalt\u001b[1X\u001b[C—\u001b[1X\u001b[1m\u001b[Ccoarse\u001b(B\u001b[m\u001b[1X\u001b[1m\u001b[Cfeatures\u001b(B\u001b[m\u001b[1X\u001b[1m\u001b[Cwith\u001b(B\u001b[m\u001b[1X\u001b[1m\u001b[Ca\u001b(B\u001b[m\u001b[1X\u001b[1m\u001b[Cprominent\u001b(B\u001b[m\u001b[1X\u001b[1m\u001b[Cforehead\u001b(B\u001b[m\u001b[1X\u001b[C—\u001b[1X\u001b[Cis\u001b[1X\u001b[Cthe\u001b[1X\u001b[Csignature\u001b[1X\u001b[Ccraniofacial\u001b[1X\u001b[Cpattern\u001b[1X\u001b[Cof\u001b[1X\u001b[CSTAT3-HIES,\u001b[1X\u001b[Cand\u001b[1X\u001b[CSTAT3\u001b[1X\u001b[Cis\u001b[35;135H \u001b[2X\u001b[2Cthe\u001b[1X\u001b[Conly\u001b[1X\u001b[Ctop\u001b[1X\u001b[Ccandidate\u001b[1X\u001b[Cthat\u001b[1X\u001b[Cmatches\u001b[1X\u001b[Cboth\u0
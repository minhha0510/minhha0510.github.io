[133.108988,"o","\u001b[2;135H   — 7/12 terms, the highest overlap. Let me verify with OMIM.                                                                  \u001b[30m\u001b[43m[0/47]\u001b[39m\u001b[49m\u001b[3;135H                                                \u001b[K\u001b[38;5;114m\u001b[4;135H●\u001b[39m \u001b[1mBash\u001b(B\u001b[m(dx-omim gene --name \"STAT3\")                                \u001b[K\u001b[38;5;246m\u001b[5;135H  ⎿  \u001b[39m{                           \u001b[K\u001b[6;135H       \"gene\": \"STAT3\",          \u001b[K\u001b[7;135H       \"gene_info\": {            \u001b[K\u001b[8;135H     \u001b[2m… +21 lines (ctrl+o to expand)\u001b(B\u001b[m                                \u001b[K\u001b[9;135H\u001b[K\u001b[38;5;114m\n●\u001b[39m \u001b[1mBash\u001b(B\u001b[m(dx-omim gene --name \"IL6ST\")                \u001b[K\u001b[38;5;246m\u001b[11;135H  ⎿  \u001b[39m{                           \u001b[K\u001b[12;135H       \"gene\": \"IL6ST\",          \u001b[K\u001b[13;135H       \"gene_info\": {                               \u001b[K\u001b[14;135H     \u001b[2m… +33 lines (ctrl+o to expand)\u001b(B\u001b[m                                \u001b[K\u001b[15;135H\u001b[K\u001b[38;5;114m\n●\u001b[39m \u001b[1mBash\u001b(B\u001b[m(dx-omim gene --name \"DOCK8\")            \u001b[K\u001b[38;5;246m\u001b[17;135H  ⎿  \u001b[39m{                           \u001b[K\u001b[18;135H \u001b[1X\u001b[C     \"gene\": \"DOCK8\",                                    \u001b[K\u001b[19;135H       \"gene_info\": {                               \u001b[K\u001b[20;135H \u001b[4X\u001b[2m\u001b[4C… +15 lines (ctrl+o to expand)\u001b(B\u001b[m\u001b[K\u001b[21;135H\u001b[K\u001b[38;5;231m\n●\u001b[39m STAT3 uniquely matches the craniofacial anchors AND the full immunologic\u001b[1X\u001b[Cpicture.\u001b[1X\u001b[CIL6ST\u001b[1X\u001b[C(HIES-4)\u001b[1X\u001b[Cis\u001b[1X\u001b[Ca\u001b[1X\u001b[Crare\u001b[1X\u001b[CSTAT3-phenocopy\u001b[1X\u001b[Cbut\u001b[K\u001b[23;135H